# MCP Server environment variables
# Copy to .env and fill in values. Never commit .env to version control.

# Database connection URL (Postgres for Olist)
MCP_DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Resource limits
MCP_MAX_ROWS=1000
MCP_DEFAULT_MAX_ROWS=100
MCP_TIMEOUT_MS=30000
MCP_MAX_RESPONSE_SIZE_BYTES=1000000
MCP_MAX_CONCURRENT_QUERIES=5

# Table access control (schema-qualified names)
# JSON array format required by pydantic-settings v2.
# Empty allowed_tables means all non-blocked tables are allowed.
MCP_ALLOWED_TABLES=["public.orders","public.order_items","public.order_payments","public.order_reviews","public.customers","public.sellers","public.products","public.product_category_name_translation"]
MCP_BLOCKED_TABLES=["public.geolocation"]

# Default schema for Postgres introspection
MCP_DB_SCHEMA=public

# Connection pool settings
MCP_CONNECTION_POOL_MIN=2
MCP_CONNECTION_POOL_MAX=10

# Sample row limit
MCP_SAMPLE_ROW_LIMIT=10

# Kaggle API credentials (for downloading Olist dataset via scripts/download_data.py)
# Get these from Kaggle → Account → API → Create New API Token.
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key
